<!DOCTYPE html>
<html lang="en" data-theme="{{ default_theme }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
{% if plotlyjs %}
{# standalone: plotly.js is embedded in the file, so it opens without internet/CDN #}
<script charset="utf-8">{{ plotlyjs | safe }}</script>
{% else %}
<script src="https://cdn.plot.ly/plotly-2.35.2.min.js" charset="utf-8"></script>
{% endif %}
<style>
  :root {
    --surface:      #fcfcfb;
    --page:         #f9f9f7;
    --text-primary: #0b0b0b;
    --text-secondary:#52514e;
    --muted:        #898781;
    --gridline:     #e1e0d9;
    --baseline:     #c3c2b7;
    --border:       rgba(11,11,11,0.10);
    --accent:       #043b72;
    --warn-bg:      rgba(250,178,25,0.10);
    color-scheme: light;
  }
  :root[data-theme="dark"] {
    --surface:      #1a1a19;
    --page:         #0d0d0d;
    --text-primary: #ffffff;
    --text-secondary:#c3c2b7;
    --muted:        #898781;
    --gridline:     #2c2c2a;
    --baseline:     #383835;
    --border:       rgba(255,255,255,0.10);
    --accent:       #3b6fd0;
    --warn-bg:      rgba(250,178,25,0.12);
    color-scheme: dark;
  }

  * { box-sizing: border-box; }
  /* The `hidden` attribute works through the browser default style (display:none), but
     an author rule such as `display: flex` takes precedence and disables it.
     Force it here. */
  [hidden] { display: none !important; }
  body {
    margin: 0;
    background: var(--page);
    color: var(--text-primary);
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    font-size: 14px;
    line-height: 1.55;
  }
  a { color: var(--accent); }
  code {
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.9em;
    background: var(--page);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0 4px;
  }
  .shell { display: flex; align-items: flex-start; max-width: 1840px; margin: 0 auto; }
  .wrap { flex: 1 1 auto; min-width: 0; max-width: 1560px; margin: 0 auto; padding: 16px 24px 40px; }

  /* ---------- left sidebar: asset class filter ---------- */
  .side {
    position: sticky; top: 0; flex: 0 0 188px; width: 188px; align-self: flex-start;
    padding: 18px 0 24px 24px; max-height: 100vh; overflow-y: auto;
  }
  .side h3 { margin: 0 0 8px; color: var(--muted); font-size: 11px; font-weight: 500;
             text-transform: uppercase; letter-spacing: 0.06em; }
  .sidelist { display: flex; flex-direction: column; gap: 4px; }
  .sidebtn {
    display: flex; align-items: center; justify-content: space-between; gap: 8px;
    background: var(--surface); color: var(--text-secondary);
    border: 1px solid var(--border); border-left: 3px solid transparent; border-radius: 8px;
    padding: 8px 10px; font: inherit; font-size: 13px; cursor: pointer; text-align: left;
  }
  .sidebtn:hover:not(:disabled) { color: var(--text-primary); border-color: var(--accent); }
  .sidebtn[aria-pressed="true"] {
    color: var(--text-primary); font-weight: 600; border-left-color: var(--accent);
    background: var(--page);
  }
  .sidebtn .cnt { color: var(--muted); font-size: 11.5px; font-variant-numeric: tabular-nums; }
  .sidebtn:disabled { opacity: 0.45; cursor: not-allowed; }
  .instrsel {
    width: 100%; background: var(--surface); color: var(--text-primary);
    border: 1px solid var(--border); border-radius: 8px; padding: 8px 8px;
    font: inherit; font-size: 13px;
  }
  .instrsel:disabled { opacity: 0.45; cursor: not-allowed; }
  .pflegend { display: inline-flex; gap: 6px; margin-left: 16px; }
  .pflbtn {
    display: inline-flex; align-items: center; gap: 7px; background: var(--surface);
    color: var(--text-secondary); border: 1px solid var(--border); border-radius: 6px;
    padding: 3px 10px; font: inherit; font-size: 12px; cursor: pointer;
  }
  .pflbtn:hover { color: var(--text-primary); border-color: var(--accent); }
  .pflbtn i { display: inline-block; width: 22px; border-top: 2px dotted currentColor; }
  .pflbtn[aria-pressed="false"] { opacity: 0.45; text-decoration: line-through; }
  .pfrow { cursor: pointer; }
  .pfrow.sel > * { background: var(--page); }
  .pfrow:hover > * { background: var(--page); }
  .ovtile { cursor: pointer; }
  .ovtile.sel { outline: 2px solid var(--accent); outline-offset: -1px; }
  .sidenote { color: var(--muted); font-size: 11.5px; line-height: 1.5; margin: 12px 0 0; }
  @media (max-width: 980px) {
    .shell { display: block; }
    .side { position: static; width: auto; max-height: none; padding: 16px 24px 0; }
    .sidelist { flex-direction: row; flex-wrap: wrap; }
  }

  /* ---------- header ---------- */
  header { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; margin-bottom: 12px; }
  header .titles { flex: 1 1 460px; display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 20px; }
  h1 { font-size: 24px; font-weight: 650; letter-spacing: -0.01em; margin: 0; }
  .sub { color: var(--text-secondary); font-size: 13px; margin: 0; }
  .meta { color: var(--muted); font-size: 12px; margin: 0; }
  .theme-toggle {
    background: var(--surface); color: var(--text-secondary);
    border: 1px solid var(--border); border-radius: 8px;
    padding: 7px 14px; font: inherit; font-size: 13px; cursor: pointer;
  }
  .theme-toggle:hover { color: var(--text-primary); }

  .headbtns { display: flex; gap: 8px; align-items: flex-start; }

  /* ---------- AUM slider ---------- */
  .aumbar {
    display: flex; flex-wrap: wrap; align-items: center; gap: 8px 20px; margin-bottom: 12px;
  }
  .aumlabel { display: flex; align-items: baseline; gap: 8px; }
  .aumlabel > span:first-child {
    color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em;
  }
  .aumlabel b { font-size: 15px; font-weight: 600; letter-spacing: -0.01em; }
  .aumlabel .mult { color: var(--text-secondary); font-size: 12px; }
  .auminput { display: flex; align-items: center; gap: 6px; font-size: 13px; }
  .auminput > span { color: var(--text-secondary); }
  .auminput input[type=number] {
    width: 110px; padding: 5px 8px; font-family: inherit; font-size: 14px;
    font-variant-numeric: tabular-nums; text-align: right;
    color: var(--text-primary); background: var(--surface);
    border: 1px solid var(--border); border-radius: 4px;
  }
  .auminput input[type=number]:focus {
    outline: 2px solid var(--accent); outline-offset: -1px; border-color: var(--accent);
  }
  .auminput button {
    margin-left: 6px; padding: 5px 10px; font-family: inherit; font-size: 12px;
    color: var(--text-secondary); background: var(--surface);
    border: 1px solid var(--border); border-radius: 4px; cursor: pointer;
  }
  .auminput button:hover { color: var(--text-primary); border-color: var(--accent); }

  /* ---------- date range ---------- */
  .rbtn {
    background: var(--page); color: var(--text-secondary);
    border: 1px solid var(--border); border-radius: 7px;
    padding: 5px 11px; font: inherit; font-size: 12.5px; cursor: pointer;
  }
  .rbtn:hover { color: var(--text-primary); border-color: var(--accent); }
  .rbtn.on { color: var(--text-primary); border-color: var(--accent); font-weight: 550; }
  .rsep { width: 1px; height: 20px; background: var(--border); margin: 0 6px; }
  .rdash { color: var(--muted); }
  /* Per-card date range control: no global range bar, each chart has its own */
  .cardrange {
    display: flex; align-items: center; gap: 6px; flex-wrap: wrap;
    padding: 8px 10px; margin: 4px 0 12px;
    background: var(--page); border: 1px solid var(--border); border-radius: 8px;
  }
  .cardrange .crlabel {
    color: var(--muted); font-size: 11px; text-transform: uppercase;
    letter-spacing: 0.05em; margin-right: 4px;
  }
  .cardrange .rbtn { background: var(--surface); }
  .cardrange input[type=date] {
    background: var(--surface); color: var(--text-primary);
    border: 1px solid var(--border); border-radius: 6px;
    padding: 4px 8px; font: inherit; font-size: 12.5px;
    font-variant-numeric: tabular-nums;
  }
  .cardrange input[type=date]:focus { outline: 2px solid var(--accent); outline-offset: -1px; }
  .cardrange .crnote { color: var(--muted); font-size: 11.5px; margin-left: auto; }

  /* ---------- tabs ---------- */
  nav.tabs { display: flex; gap: 4px; flex-wrap: wrap; border-bottom: 1px solid var(--border); margin-bottom: 24px; }
  nav.tabs button {
    background: none; border: none; border-bottom: 2px solid transparent;
    color: var(--text-secondary); font: inherit; font-size: 13.5px;
    padding: 10px 14px; cursor: pointer; margin-bottom: -1px;
  }
  nav.tabs button:hover { color: var(--text-primary); }
  nav.tabs button[aria-selected="true"] { color: var(--text-primary); border-bottom-color: var(--accent); font-weight: 550; }

  .panel { display: none; }
  .panel.active { display: block; }
  .intro { color: var(--text-secondary); font-size: 13.5px; margin: 0 0 20px; max-width: 92ch; }

  /* ---------- cards ---------- */
  /* `repeat(auto-fit, minmax(420px, 1fr))` is avoided: `auto-fit` collapses empty
     tracks after placement, so the `-1` in `.card.wide { grid-column: 1/-1 }` is
     resolved differently per card and only the first wide card spans the full width.
     The column count is explicit so `-1` is well defined (two columns).
     `minmax(0, 1fr)` instead of `1fr`: `1fr` uses min-content as a floor, so a card
     with a wide nowrap table pushes the track and overflows the grid. */
  .cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  @media (max-width: 920px) { .cards { grid-template-columns: minmax(0, 1fr); } }
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 18px 20px 16px; }
  .card:has(.ovasof) { position: relative; }
  .ovasof { position: absolute; top: 18px; right: 20px; margin: 0; }
  .card.wide { grid-column: 1 / -1; }
  .card h2 { font-size: 15px; font-weight: 600; margin: 0 0 4px; }
  .card .cardsub { color: var(--text-secondary); font-size: 12.5px; margin: 0 0 12px; }
  .card .note {
    display: inline-block; background: var(--warn-bg); color: var(--text-secondary);
    border: 1px solid var(--border); border-radius: 6px;
    font-size: 11.5px; padding: 3px 8px; margin: 0 0 12px;
  }
  .card h3.subhead {
    font-size: 12.5px; font-weight: 600; color: var(--text-secondary);
    margin: 18px 0 6px; text-transform: uppercase; letter-spacing: 0.04em;
  }
  /* min-height: if the height is 0 before render or on failure, later content overlaps.
     position: relative: Plotly's inner svg is absolute, so this sets the reference box. */
  .chart { width: 100%; min-height: 240px; position: relative; }
  .chart .plot-container, .chart .svg-container { max-width: 100%; }
  /* Plotly sets pointer-events:none on the axis layer, which blocks tick label clicks.
     Some cards hide an asset when its y-axis label is clicked, so re-enable it in CSS too
     (inline JS styles alone can miss the react() re-render timing). */
  .chart .yaxislayer-above, .chart .yaxislayer-above g.ytick,
  .chart .yaxislayer-above g.ytick text { pointer-events: all; }

  /* ---------- unit toggle ---------- */
  .unitbar { display: inline-flex; gap: 0; margin: 0 0 12px; border-radius: 7px; overflow: hidden;
             border: 1px solid var(--border); }
  .ubtn {
    background: var(--page); color: var(--text-secondary);
    border: none; border-right: 1px solid var(--border);
    padding: 5px 14px; font: inherit; font-size: 12.5px; cursor: pointer;
    font-variant-numeric: tabular-nums;
  }
  .ubtn:last-child { border-right: none; }
  .ubtn:hover { color: var(--text-primary); }
  .ubtn.on { background: var(--accent); color: #fff; font-weight: 550; }

  /* ---------- context menu ---------- */
  .ctxmenu {
    position: fixed; z-index: 99999; min-width: 172px;
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 8px; padding: 4px; box-shadow: 0 6px 20px rgba(0,0,0,0.18);
  }
  .ctxmenu button {
    display: block; width: 100%; text-align: left; background: none; border: none;
    color: var(--text-secondary); font: inherit; font-size: 12.5px;
    padding: 7px 10px; border-radius: 6px; cursor: pointer;
  }
  .ctxmenu button:hover { background: var(--page); color: var(--text-primary); }

  /* ---------- headlines ---------- */
  ul.hlist { margin: 0 0 14px; padding-left: 18px; }
  ul.hlist li { margin: 0 0 7px; line-height: 1.6; font-size: 13.5px; }
  ul.hlist li:last-child { margin-bottom: 0; }

  /* ---------- scenario card ---------- */
  .scenbar {
    display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin: 0 0 10px;
  }
  .scenbar label {
    color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em;
  }
  .scenbar select {
    background: var(--page); color: var(--text-primary);
    border: 1px solid var(--border); border-radius: 7px;
    padding: 5px 10px; font: inherit; font-size: 12.5px; cursor: pointer; min-width: 190px;
  }
  /* Hidden asset chip row: assets hidden by clicking a y-axis label collect here */
  .hidebar {
    display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
    padding: 8px 10px; margin: 0 0 10px;
    background: var(--page); border: 1px solid var(--border); border-radius: 8px;
  }
  .hidebar .hlabel {
    color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em;
  }
  .hidebar .hchips { display: flex; flex-wrap: wrap; gap: 5px; }
  .hchip {
    background: var(--surface); border: 1px solid var(--border); border-radius: 999px;
    padding: 3px 10px; font: inherit; font-size: 12px; cursor: pointer;
    color: var(--text-secondary);
  }
  .hchip:hover { color: var(--text-primary); border-color: var(--accent); }
  .hchip::after { content: " +"; color: var(--muted); }
  .hidebar .hall { margin-left: auto; }
  .ctsum {
    color: var(--text-secondary); font-size: 12.5px; margin-left: auto;
    font-variant-numeric: tabular-nums;
  }
  /* ---------- position overview: KPI + regime chip tiles ---------- */
  .kpigrid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 8px; margin: 0 0 10px;
  }
  .kpi { background: var(--page); border: 1px solid var(--border); border-radius: 10px;
         padding: 8px 12px; }
  .kpi .kl { color: var(--muted); font-size: 11px; text-transform: uppercase;
             letter-spacing: 0.05em; }
  .kpi .kv { display: block; font-size: 20px; font-weight: 600; margin: 1px 0 0;
             font-variant-numeric: tabular-nums; }
  .kpi .ks { color: var(--text-secondary); font-size: 12px; font-variant-numeric: tabular-nums; }
  .ovtiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
             gap: 8px; }
  .ovtile { background: var(--page); border: 1px solid var(--border);
            border-left: 4px solid var(--baseline); border-radius: 10px; padding: 6px 9px; }
  .ovtile .tc { font-weight: 600; font-size: 14px; }
  .ovtile .tn { color: var(--muted); font-size: 11.5px; margin-left: 6px; }
  .ovtile .tv { display: block; font-size: 18px; font-weight: 600; margin: 1px 0 0; white-space: nowrap;
                font-variant-numeric: tabular-nums; }
  .ovtile .td { color: var(--text-secondary); font-size: 11px; font-weight: 400; margin-left: 5px;
                font-variant-numeric: tabular-nums; }
  .regchip { display: inline-block; border: 1px solid; border-radius: 999px;
             padding: 1px 6px; font-size: 10.5px; margin: 0 3px 0 0; white-space: nowrap; }
  .ovtile .chips { display: flex; flex-wrap: nowrap; margin-top: 4px; }
  .scmoves {
    color: var(--text-secondary); font-size: 12px; margin: 0 0 10px;
    font-variant-numeric: tabular-nums;
  }

  /* ---------- sector / asset toggle panel ---------- */
  /* Asset class buttons sit in one horizontal row, expanded assets go below */
  .exppanel { display: block; margin: 0 0 10px; }
  .secrow { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 8px; }
  .exprow {
    display: grid; grid-template-columns: 118px 1fr; gap: 8px;
    align-items: start; margin: 0 0 6px;
  }
  .exprow > .seclab {
    color: var(--muted); font-size: 11.5px; padding-top: 5px; text-align: right;
  }
  .secbtn {
    display: inline-flex; align-items: center; gap: 6px;
    background: var(--page); border: 1px solid var(--border); border-radius: 7px;
    padding: 4px 9px; font: inherit; font-size: 11.5px; cursor: pointer;
    color: var(--muted); text-align: left;
  }
  .secbtn .dot { width: 8px; height: 8px; border-radius: 50%; flex: 0 0 8px;
                 border: 1px solid var(--border); }
  .secbtn .cnt { color: var(--muted); font-size: 10.5px; font-variant-numeric: tabular-nums; }
  .secbtn:hover { color: var(--text-primary); }
  .secbtn.shown { color: var(--text-primary); border-color: var(--accent); font-weight: 550; }
  .mktwrap { display: flex; flex-wrap: wrap; gap: 5px; padding-top: 2px; }
  .mktbtn {
    background: var(--page); border: 1px solid var(--border); border-radius: 999px;
    padding: 4px 10px 4px 8px; font: inherit; font-size: 12px; cursor: pointer;
    color: var(--muted); display: inline-flex; align-items: center; gap: 5px;
  }
  /* The asset button swatch is a line segment, not a dot: it mirrors the chart
     line style (solid/dashed/dotted) so the matching line is easy to find. */
  .mktbtn .swatch { width: 18px; height: 0; flex: 0 0 18px;
                    border-top-width: 2.5px; border-top-style: solid;
                    border-top-color: transparent; }
  .mktbtn:hover { color: var(--text-primary); }
  .mktbtn.shown { color: var(--text-primary); border-color: var(--accent); font-weight: 550; }
  .expactions { display: inline-flex; gap: 8px; align-items: center; margin-left: auto; }
  .expactions label { color: var(--muted); font-size: 11px;
                      text-transform: uppercase; letter-spacing: 0.05em; }

  /* ---------- variant selector ---------- */
  .variantbar { display: flex; align-items: center; gap: 8px; margin: 0 0 12px;
               flex-wrap: wrap; }
  .variantbar select[hidden] { display: none; }
  .variantbar label { color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; }
  .variantbar select {
    background: var(--page); color: var(--text-primary);
    border: 1px solid var(--border); border-radius: 7px;
    padding: 5px 10px; font: inherit; font-size: 12.5px; cursor: pointer; min-width: 200px;
  }

  /* ---------- table view ---------- */
  .tableview { margin-top: 12px; }
  .tableview > summary {
    cursor: pointer; color: var(--muted); font-size: 12px;
    list-style: none; padding: 6px 0; user-select: none;
  }
  .tableview > summary::-webkit-details-marker { display: none; }
  .tableview > summary::before { content: "▸ "; }
  .tableview[open] > summary::before { content: "▾ "; }
  .tableview > summary:hover { color: var(--text-primary); }
  .tablewrap { overflow-x: auto; max-height: 520px; overflow-y: auto; }
  table.data-table { border-collapse: collapse; width: 100%; font-size: 12.5px; font-variant-numeric: tabular-nums; }
  table.data-table th, table.data-table td { padding: 6px 12px 6px 0; text-align: left; white-space: nowrap; }
  table.data-table thead th {
    position: sticky; top: 0; background: var(--surface);
    color: var(--muted); font-weight: 500; font-size: 11px;
    text-transform: uppercase; letter-spacing: 0.04em;
    border-bottom: 1px solid var(--baseline);
  }
  table.data-table tbody tr { border-bottom: 1px solid var(--gridline); }
  table.data-table tbody tr:last-child { border-bottom: none; }
  table.data-table tbody th { color: var(--text-secondary); font-weight: 500; }
  .muted { color: var(--muted); font-size: 12.5px; }
  .warnbox {
    margin-top: 14px; padding: 10px 14px; background: var(--warn-bg);
    border: 1px solid var(--border); border-radius: 8px; font-size: 12.5px;
  }
  .warnbox ul { margin: 6px 0 0; padding-left: 20px; }

  footer { margin-top: 40px; color: var(--muted); font-size: 12px; border-top: 1px solid var(--border); padding-top: 16px; }
</style>
</head>
<body>
<div class="shell">
<aside class="side" id="sideBar" aria-label="Asset class filter">
  <h3>Asset class</h3>
  <div class="sidelist" id="sectorList"></div>
  <h3 style="margin-top:18px">Market</h3>
  <select id="instrSel" class="instrsel" aria-label="Price chart market"></select>
  <p class="sidenote" id="sideNote"></p>
</aside>
<div class="wrap">

  <header>
    <div class="titles">
      <h1>{{ title }}</h1>
      <p class="meta">Positions as of <b>{{ as_of }}</b> &nbsp;·&nbsp; Benchmark {{ benchmark }} &nbsp;·&nbsp; Generated {{ generated }}</p>
    </div>
    <div class="headbtns">
      <button class="theme-toggle" id="themeToggle" type="button">◐ Theme</button>
    </div>
  </header>

  <nav class="tabs" role="tablist">
    {% for tab in tabs %}
    <button role="tab" data-tab="{{ tab.id }}" aria-selected="{{ 'true' if loop.first else 'false' }}">{{ tab.label }}</button>
    {% endfor %}
  </nav>

  {% for tab in tabs %}
  <section class="panel {{ 'active' if loop.first else '' }}" id="panel-{{ tab.id }}" role="tabpanel"{{ ' data-filter="1"' if tab.id in filter_tabs else '' }}{{ ' data-instr="1"' if tab.id == 'main' else '' }}>
    {% if tab.intro %}<p class="intro">{{ tab.intro | safe }}</p>{% endif %}
    <div class="cards">
      {% for card in tab.cards %}
      {% set cardkey = card.id ~ '-' ~ loop.index0 %}
      <div class="card {{ 'wide' if card.wide else '' }}" id="card-{{ cardkey }}">
        <h2>{{ card.title }}</h2>
        {% if card.subtitle %}<p class="cardsub">{{ card.subtitle | safe }}</p>{% endif %}
        {% if card.note %}<span class="note">{{ card.note }}</span>{% endif %}

        {% if card.variants or card.variant_tables %}
        <div class="variantbar">
          <label for="sel-{{ cardkey }}">{{ card.variant_label }}</label>
          <select id="sel-{{ cardkey }}" data-card="{{ cardkey }}" data-sel="1"
                  {{ 'hidden' if card.variant_buttons }}>
            {% for opt in card.sel1_opts %}
